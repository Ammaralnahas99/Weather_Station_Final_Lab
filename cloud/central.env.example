# Copy to central.env and fill in real values. Never commit central.env.

# Address the Weather Stations VM will use to reach Kafka on THIS machine.
# Prefer the central VM's PRIVATE IP if both VMs are in the same VPC/region
# (no public exposure of Kafka needed); use the PUBLIC IP only if they're
# on different networks.
KAFKA_ADVERTISED_HOST=10.0.0.10

# Aiven PostgreSQL connection details, from the Aiven console's service
# "Overview" tab (Host / Port / Database name / User / Password fields).
DB_HOST=pg-xxxxxxx-yourproject.aivencloud.com
DB_PORT=15432
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=changeme
